# ==============================================================================
# PAU NOC Website & Landing Page Monitoring Service - Environment Configuration
# ==============================================================================

# Server Listening Port (Default: 3000)
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# ==============================================================================
# Cryptographic JWT & Session Security
# ==============================================================================
# The HMAC-SHA256 secret key used for signing session JWTs and anti-CSRF tokens.
# Security Requirements:
# - Minimum 256 bits of entropy (at least 32 characters, recommended 64-character hex string)
# - Never use predictable or default passwords
# Generate a cryptographically strong 512-bit key using:
#   openssl rand -hex 64
#   or: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-512-bit-cryptographically-secure-random-secret-key-here

# Optional: Previous JWT secrets for zero-downtime secret rotation (comma-separated).
# When rotating keys, move your old JWT_SECRET here so active user sessions remain valid.
# JWT_PREVIOUS_SECRETS=previous-key-1,previous-key-2

# Backwards-compatible alias for JWT_SECRET
# AUTH_SECRET=your-512-bit-cryptographically-secure-random-secret-key-here

# ==============================================================================
# Database Configuration (Optional)
# ==============================================================================
# Custom SQLite database location (defaults to data/monitoring.db)
# DB_PATH=/var/www/noc-monitor/data/monitoring.db
